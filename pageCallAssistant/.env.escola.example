# ────────────────────────────────────────────────
# SpeakFlow Escolas — Variáveis de Ambiente
# Copie as linhas relevantes para o seu .env
# ────────────────────────────────────────────────

# Feature flags (false = área escolar invisível ao usuário)
FEATURE_ESCOLAS=false
NEXT_PUBLIC_FEATURE_ESCOLAS=false

# JWT para cookies escolares (sf_edu_ctx e sf_edu_student)
# Mínimo 32 caracteres aleatórios — NÃO use o valor de exemplo em produção
EDU_STUDENT_JWT_SECRET=TROQUE_POR_SEGREDO_ALEATORIO_DE_32_CHARS

# Assinatura de hashes de notas (opcional — se ausente usa HMAC dev)
# Formato PEM de chave privada RSA ou EC
EDU_SIGNING_PRIVATE_KEY=
EDU_SIGNING_KEY_ID=key-2027-01

# Pseudonimização de ID de aluno nas chamadas de IA
# Mínimo 16 caracteres aleatórios
EDU_PSEUDONYM_SECRET=TROQUE_POR_SEGREDO_PSEUDONIMIZACAO
