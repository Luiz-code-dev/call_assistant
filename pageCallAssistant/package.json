{
  "name": "page-call-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma generate --schema prisma/escolas-catalogo/schema.prisma && prisma generate --schema prisma/escolas/schema.prisma && next build",
    "start": "sh scripts/start.sh",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:generate:escolas": "prisma generate --schema prisma/escolas/schema.prisma",
    "db:generate:catalogo": "prisma generate --schema prisma/escolas-catalogo/schema.prisma",
    "db:generate:all": "npm run db:generate && npm run db:generate:escolas && npm run db:generate:catalogo",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:catalogo": "prisma migrate deploy --schema prisma/escolas-catalogo/schema.prisma",
    "db:migrate:escolas": "node scripts/escolas/migrate-all.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "escola:admin-master": "npx tsx scripts/escolas/criar-admin-master.ts",
    "escola:seed-familia-demo": "node prisma/seed-familia-demo.mjs",
    "escola:seed-demo": "node scripts/escolas/seed-demo.mjs",
    "escolas:reindex": "node scripts/escolas/reindex.mjs",
    "escolas:seed-demo": "node scripts/escolas/seed-demo.mjs",
    "escolas:seed-usuarios": "node scripts/escolas/seed-usuarios-demo.mjs",
    "escolas:bootstrap": "node scripts/escolas/bootstrap-catalogo.mjs",
    "escolas:bncc-import": "node scripts/escolas/bncc-import.mjs",
    "escolas:migrate-all": "node scripts/escolas/migrate-all.mjs",
    "escolas:test:integration": "node scripts/escolas/test-integration.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@aws-sdk/s3-request-presigner": "^3.1155.0",
    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@react-pdf/renderer": "^3.4.4",
    "@stripe/stripe-js": "^4.9.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo-server-sdk": "^6.1.0",
    "jose": "^5.9.6",
    "jsqr": "^1.4.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.468.0",
    "next": "^14.2.35",
    "openai": "^6.34.0",
    "prisma": "^5.22.0",
    "qrcode.react": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.1",
    "react-is": "^19.3.1",
    "recharts": "^3.8.1",
    "resend": "^6.10.0",
    "sonner": "^1.7.1",
    "stripe": "^16.12.0",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/web-push": "^3.6.4",
    "@types/xlsx": "*",
    "@vitest/coverage-v8": "^1.6.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.0",
    "vitest": "^1.6.1"
  }
}
