{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false }
    },
    "production": {
      "android": { "buildType": "app-bundle" },
      "ios": { "image": "latest" }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account-escolas.json",
        "track": "internal"
      },
      "ios": {
        "appleId": "REPLACE_WITH_ESCOLAS_APPLE_ID",
        "ascAppId": "REPLACE_WITH_ESCOLAS_ASC_APP_ID"
      }
    }
  }
}
