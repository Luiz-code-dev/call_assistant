# Base URL das APIs do SpeakFlow (Railway)
# Produção: https://speakflow.ia.br
# Dev: http://localhost:3000
EXPO_PUBLIC_API_URL=https://speakflow.ia.br

# App environment
EXPO_PUBLIC_APP_ENV=production

# EAS Project ID — obtenha em: https://expo.dev após rodar `eas init`
# Necessário para push notifications funcionarem no app
EXPO_PUBLIC_EAS_PROJECT_ID=REPLACE_WITH_EAS_PROJECT_ID
